+import { DefaultConfigService } from "@bitwarden/common/platform/services/config/default-config.service";
+import { UserId } from "@bitwarden/common/types/guid";
+
+import { communityConfigServiceFactory } from "./community-config.service";
+
+describe("communityConfigServiceFactory", () => {
+  it("enables the local phishing flag and delegates server-backed flags", async () => {
+    const userId = "community-user" as UserId;
+    const getFeatureFlag$ = jest.fn().mockReturnValue(of(false));
+    const getFeatureFlag = jest.fn().mockResolvedValue(false);
+    const userCachedFeatureFlag$ = jest.fn().mockReturnValue(of(false));
+    const defaultConfigService = {
+      getFeatureFlag$,
+      getFeatureFlag,
+      userCachedFeatureFlag$,
+    } as unknown as DefaultConfigService;
+
+    const service = communityConfigServiceFactory(defaultConfigService);
+
+    await expect(
+      firstValueFrom(service.getFeatureFlag$(FeatureFlag.PhishingDetection)),
+    ).resolves.toBe(true);
+    await expect(service.getFeatureFlag(FeatureFlag.PhishingDetection)).resolves.toBe(true);
+    await expect(
+      firstValueFrom(service.userCachedFeatureFlag$(FeatureFlag.PhishingDetection, userId)),
+    ).resolves.toBe(true);
+
+    await expect(
+      firstValueFrom(service.getFeatureFlag$(FeatureFlag.PM34203TemporaryItemSharing)),
+    ).resolves.toBe(false);
+    expect(getFeatureFlag$).toHaveBeenCalledWith(FeatureFlag.PM34203TemporaryItemSharing);
+  });
+});
diff --git a/apps/desktop/src/app/services/community-config.service.ts b/apps/desktop/src/app/services/community-config.service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44b8f22c3ea80117c9fc27d1bf2afd9b93905160
--- /dev/null
+++ b/apps/desktop/src/app/services/community-config.service.ts
@@ -0,0 +1,37 @@
+import { of } from "rxjs";
+
+import { FeatureFlag, FeatureFlagValueType } from "@bitwarden/common/enums/feature-flag.enum";
+import { ConfigService } from "@bitwarden/common/platform/abstractions/config/config.service";
+import { DefaultConfigService } from "@bitwarden/common/platform/services/config/default-config.service";
+
+const communityEnabledFlags = new Set<FeatureFlag>([
+  FeatureFlag.PhishingDetection,
+]);
+
+/** Keeps server-controlled experiments intact while enabling the local phishing blocker. */
+export function communityConfigServiceFactory(
+  defaultConfigService: DefaultConfigService,
+): ConfigService {
+  const getFeatureFlag$ = defaultConfigService.getFeatureFlag$.bind(defaultConfigService);
+  const getFeatureFlag = defaultConfigService.getFeatureFlag.bind(defaultConfigService);
+  const userCachedFeatureFlag$ =
+    defaultConfigService.userCachedFeatureFlag$.bind(defaultConfigService);
+
+  defaultConfigService.getFeatureFlag$ = <Flag extends FeatureFlag>(key: Flag) =>
+    communityEnabledFlags.has(key) ? of(true as FeatureFlagValueType<Flag>) : getFeatureFlag$(key);
+
+  defaultConfigService.getFeatureFlag = <Flag extends FeatureFlag>(key: Flag) =>
+    communityEnabledFlags.has(key)
+      ? Promise.resolve(true as FeatureFlagValueType<Flag>)
+      : getFeatureFlag(key);
+
+  defaultConfigService.userCachedFeatureFlag$ = <Flag extends FeatureFlag>(
+    key: Flag,
+    userId: Parameters<DefaultConfigService["userCachedFeatureFlag$"]>[1],
+  ) =>
+    communityEnabledFlags.has(key)
+      ? of(true as FeatureFlagValueType<Flag>)
+      : userCachedFeatureFlag$(key, userId);
+
+  return defaultConfigService;
+}
