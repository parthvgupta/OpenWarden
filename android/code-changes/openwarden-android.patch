+package com.x8bit.bitwarden.ui.platform.feature.settings.vaulthealth
+
+import androidx.lifecycle.viewModelScope
+import com.bitwarden.ui.platform.base.BaseViewModel
+import com.bitwarden.vault.CipherType
+import com.bitwarden.vault.CipherView
+import com.x8bit.bitwarden.data.auth.datasource.sdk.model.PasswordStrength
+import com.x8bit.bitwarden.data.auth.repository.AuthRepository
+import com.x8bit.bitwarden.data.auth.repository.model.BreachCountResult
+import com.x8bit.bitwarden.data.auth.repository.model.PasswordStrengthResult
+import com.x8bit.bitwarden.data.vault.manager.model.GetCipherResult
+import com.x8bit.bitwarden.data.vault.repository.VaultRepository
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import java.net.URI
+import java.time.Clock
+import java.time.Duration
+import javax.inject.Inject
+
+private const val OLD_PASSWORD_AGE_DAYS = 180L
+private const val MIN_HEALTH_SCORE = 0
+private const val MAX_HEALTH_SCORE = 100
+private val OLD_PASSWORD_AGE: Duration = Duration.ofDays(OLD_PASSWORD_AGE_DAYS)
+
+/** Builds a device-local security report from decrypted vault items. */
+@HiltViewModel
+@Suppress("TooManyFunctions")
+class VaultHealthViewModel @Inject constructor(
+    private val vaultRepository: VaultRepository,
+    private val authRepository: AuthRepository,
+    private val clock: Clock,
+) : BaseViewModel<VaultHealthState, VaultHealthEvent, VaultHealthAction>(
+    initialState = VaultHealthState(),
+) {
+    override fun handleAction(action: VaultHealthAction) {
+        when (action) {
+            VaultHealthAction.BackClick -> sendEvent(VaultHealthEvent.NavigateBack)
+            VaultHealthAction.ScanClick -> scanVault()
+        }
+    }
+
+    private fun scanVault() {
+        if (state.isScanning) return
+        mutableStateFlow.update { it.copy(isScanning = true, error = false) }
+
+        viewModelScope.launch {
+            runCatching { buildReport() }
+                .onSuccess { report ->
+                    mutableStateFlow.update {
+                        it.copy(isScanning = false, report = report, error = false)
+                    }
+                }
+                .onFailure {
+                    mutableStateFlow.update { state ->
+                        state.copy(isScanning = false, error = true)
+                    }
+                }
+        }
+    }
+
+    private suspend fun buildReport(): VaultHealthReport {
+        val logins = loadLogins()
+        val riskIds = findRiskIds(logins)
+        return VaultHealthReport(
+            total = logins.size,
+            score = calculateHealthScore(
+                total = logins.size,
+                atRisk = riskIds.all.size,
+            ),
+            exposed = riskIds.exposed.size,
+            weak = riskIds.weak.size,
+            reused = riskIds.reused.size,
+            old = riskIds.old.size,
+            unsecured = riskIds.unsecured.size,
+            suspicious = riskIds.suspicious.size,
+            duplicate = riskIds.duplicate.size,
+            missingTwoFactor = riskIds.missingTwoFactor.size,
+        )
+    }
+
+    private suspend fun loadLogins(): List<CipherView> =
+        vaultRepository.decryptCipherListResultStateFlow
+            .first { it.data != null }
+            .data
+            ?.successes
+            .orEmpty()
+            .mapNotNull { listItem ->
+                val cipherId = listItem.id ?: return@mapNotNull null
+                when (val result = vaultRepository.getCipher(cipherId)) {
+                    is GetCipherResult.Success -> result.cipherView
+                    else -> null
+                }
+            }
+            .filter { cipher ->
+                cipher.type == CipherType.LOGIN &&
+                    cipher.deletedDate == null &&
+                    cipher.archivedDate == null &&
+                    !cipher.login?.password.isNullOrBlank()
+            }
+
+    private suspend fun findRiskIds(logins: List<CipherView>): VaultHealthRiskIds {
+        val passwordGroups = logins.groupBy { requireNotNull(it.login?.password) }
+        return VaultHealthRiskIds(
+            exposed = findExposedIds(logins = logins, passwords = passwordGroups.keys),
+            weak = findWeakIds(logins),
+            reused = passwordGroups
+                .values
+                .filter { it.size > 1 }
+                .flatten()
+                .mapNotNullTo(mutableSetOf()) { it.id },
+            old = findOldIds(logins),
+            unsecured = findUnsecuredIds(logins),
+            suspicious = findSuspiciousIds(logins),
+            duplicate = findDuplicateIds(logins),
+            missingTwoFactor = findMissingTwoFactorIds(logins),
+        )
+    }
+
+    private suspend fun findWeakIds(logins: List<CipherView>): Set<String> =
+        logins
+            .filter { cipher ->
+                when (
+                    val result = authRepository.getPasswordStrength(
+                        email = null,
+                        password = requireNotNull(cipher.login?.password),
+                    )
+                ) {
+                    is PasswordStrengthResult.Success ->
+                        result.passwordStrength.ordinal <= PasswordStrength.LEVEL_2.ordinal
+                    is PasswordStrengthResult.Error -> false
+                }
+            }
+            .mapNotNullTo(mutableSetOf()) { it.id }
+
+    private suspend fun findExposedIds(
+        logins: List<CipherView>,
+        passwords: Set<String>,
+    ): Set<String> {
+        val exposedPasswords = mutableSetOf<String>()
+        passwords.forEach { password ->
+            val result = authRepository.getPasswordBreachCount(password)
+            if (result is BreachCountResult.Success && result.breachCount > 0) {
+                exposedPasswords += password
+            }
+        }
+        return logins
+            .filter { it.login?.password in exposedPasswords }
+            .mapNotNullTo(mutableSetOf()) { it.id }
+    }
+
+    private fun findOldIds(logins: List<CipherView>): Set<String> {
+        val oldestAllowed = clock.instant().minus(OLD_PASSWORD_AGE)
+        return logins.filter { cipher ->
+            val changed = cipher.login?.passwordRevisionDate ?: cipher.revisionDate
+            changed.isBefore(oldestAllowed)
+        }.mapNotNullTo(mutableSetOf()) { it.id }
+    }
+
+    private fun findUnsecuredIds(logins: List<CipherView>): Set<String> =
+        logins.filter { cipher ->
+            cipher.login?.uris.orEmpty().any { uri ->
+                uri.uri?.trim()?.startsWith(prefix = "http://", ignoreCase = true) == true
+            }
+        }.mapNotNullTo(mutableSetOf()) { it.id }
+
+    private fun findSuspiciousIds(logins: List<CipherView>): Set<String> =
+        logins.filter { cipher ->
+            cipher.login?.uris.orEmpty().any { uri ->
+                runCatching { URI(uri.uri.orEmpty()).host }
+                    .getOrNull()
+                    ?.split('.')
+                    ?.any { label -> label.startsWith("xn--", ignoreCase = true) } == true
+            }
+        }.mapNotNullTo(mutableSetOf()) { it.id }
+
+    private fun findMissingTwoFactorIds(logins: List<CipherView>): Set<String> =
+        logins.filter { cipher ->
+            cipher.login?.totp.isNullOrBlank() &&
+                cipher.login?.fido2Credentials.isNullOrEmpty()
+        }.mapNotNullTo(mutableSetOf()) { it.id }
+
+    private fun findDuplicateIds(logins: List<CipherView>): Set<String> =
+        logins
+            .groupBy { cipher ->
+                val username = cipher.login?.username.orEmpty().trim().lowercase()
+                val rawUri = cipher.login?.uris?.firstOrNull()?.uri.orEmpty().trim()
+                val host = runCatching { URI(rawUri).host }
+                    .getOrNull()
+                    ?.lowercase()
+                    ?: rawUri.lowercase()
+                "$host\n$username"
+            }
+            .filterKeys { it.isNotBlank() }
+            .values
+            .filter { duplicates -> duplicates.size > 1 }
+            .flatten()
+            .mapNotNullTo(mutableSetOf()) { it.id }
+
+    private fun calculateHealthScore(total: Int, atRisk: Int): Int =
+        if (total == 0) {
+            MAX_HEALTH_SCORE
+        } else {
+            (((total - atRisk) * MAX_HEALTH_SCORE.toDouble()) / total)
+                .toInt()
+                .coerceIn(MIN_HEALTH_SCORE, MAX_HEALTH_SCORE)
+        }
+}
+
+/** State for the device-local report. */
+data class VaultHealthState(
+    val isScanning: Boolean = false,
+    val report: VaultHealthReport? = null,
+    val error: Boolean = false,
+)
+
+/** Aggregate counts shown by the report. */
+data class VaultHealthReport(
+    val total: Int,
+    val score: Int,
+    val exposed: Int,
+    val weak: Int,
+    val reused: Int,
+    val old: Int,
+    val unsecured: Int,
+    val suspicious: Int,
+    val duplicate: Int,
+    val missingTwoFactor: Int,
+)
+
+/** User actions from the vault health screen. */
+sealed class VaultHealthAction {
+    /** Return to Settings. */
+    data object BackClick : VaultHealthAction()
+
+    /** Re-run the local vault scan. */
+    data object ScanClick : VaultHealthAction()
+}
+
+/** One-time screen events. */
+sealed class VaultHealthEvent {
+    /** Return to Settings. */
+    data object NavigateBack : VaultHealthEvent()
+}
+
+private data class VaultHealthRiskIds(
+    val exposed: Set<String>,
+    val weak: Set<String>,
+    val reused: Set<String>,
+    val old: Set<String>,
+    val unsecured: Set<String>,
+    val suspicious: Set<String>,
+    val duplicate: Set<String>,
+    val missingTwoFactor: Set<String>,
+) {
+    val all: Set<String>
+        get() = exposed + weak + reused + old + unsecured + suspicious + duplicate +
+            missingTwoFactor
+}
