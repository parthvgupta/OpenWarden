+@file:OmitFromCoverage
+
+package com.x8bit.bitwarden.ui.platform.feature.settings.vaulthealth
+
+import androidx.navigation.NavController
+import androidx.navigation.NavGraphBuilder
+import androidx.navigation.NavOptions
+import com.bitwarden.annotation.OmitFromCoverage
+import com.bitwarden.ui.platform.base.util.composableWithPushTransitions
+import kotlinx.serialization.Serializable
+
+/** Route for the device-local vault health report. */
+@Serializable
+data object VaultHealthRoute
+
+/** Adds the vault health destination to a navigation graph. */
+fun NavGraphBuilder.vaultHealthDestination(onNavigateBack: () -> Unit) {
+    composableWithPushTransitions<VaultHealthRoute> {
+        VaultHealthScreen(onNavigateBack = onNavigateBack)
+    }
+}
+
+/** Navigates to the vault health report. */
+fun NavController.navigateToVaultHealth(navOptions: NavOptions? = null) {
+    navigate(route = VaultHealthRoute, navOptions = navOptions)
+}
