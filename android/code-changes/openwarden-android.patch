+/** Describes the independent, device-local capabilities included with OpenWarden. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun OpenWardenCommunityScreen(
+    onNavigateBack: () -> Unit,
+) {
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior(rememberTopAppBarState())
+    BitwardenScaffold(
+        modifier = Modifier
+            .fillMaxSize()
+            .nestedScroll(scrollBehavior.nestedScrollConnection),
+        topBar = {
+            BitwardenTopAppBar(
+                title = stringResource(BitwardenString.openwarden),
+                scrollBehavior = scrollBehavior,
+                navigationIcon = rememberVectorPainter(BitwardenDrawable.ic_back),
+                navigationIconContentDescription = stringResource(BitwardenString.back),
+                onNavigationIconClick = onNavigateBack,
+            )
+        },
+    ) { OpenWardenCommunityContent() }
+}
+
+@Composable
+private fun OpenWardenCommunityContent() {
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState()),
+    ) {
+        Spacer(Modifier.height(16.dp))
+        Text(
+            text = stringResource(BitwardenString.openwarden_community_edition_version),
+            style = BitwardenTheme.typography.labelLarge,
+            color = BitwardenTheme.colorScheme.text.secondary,
+            modifier = Modifier.standardHorizontalMargin(),
+        )
+        Spacer(Modifier.height(12.dp))
+        Text(
+            text = stringResource(BitwardenString.openwarden_intro),
+            style = BitwardenTheme.typography.bodyMedium,
+            color = BitwardenTheme.colorScheme.text.primary,
+            modifier = Modifier.standardHorizontalMargin(),
+        )
+        Spacer(Modifier.height(24.dp))
+        Text(
+            text = stringResource(BitwardenString.included_with_openwarden),
+            style = BitwardenTheme.typography.titleMedium,
+            color = BitwardenTheme.colorScheme.text.primary,
+            modifier = Modifier.standardHorizontalMargin(),
+        )
+        Spacer(Modifier.height(8.dp))
+        OPENWARDEN_FEATURES.forEach { feature ->
+            OpenWardenFeatureRow(text = stringResource(feature))
+        }
+        Spacer(Modifier.height(16.dp))
+        BitwardenInfoCalloutCard(
+            text = stringResource(BitwardenString.openwarden_compatibility_notice),
+            startIcon = IconData.Local(BitwardenDrawable.ic_info_circle),
+            modifier = Modifier
+                .standardHorizontalMargin()
+                .fillMaxWidth(),
+        )
+        Spacer(Modifier.height(12.dp))
+        BitwardenInfoCalloutCard(
+            text = stringResource(BitwardenString.openwarden_independent_project_notice),
+            startIcon = IconData.Local(BitwardenDrawable.ic_shield),
+            modifier = Modifier
+                .standardHorizontalMargin()
+                .fillMaxWidth(),
+        )
+        Spacer(Modifier.height(16.dp))
+        Spacer(Modifier.navigationBarsPadding())
+    }
+}
+
+@Composable
+private fun OpenWardenFeatureRow(
+    text: String,
+) {
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .standardHorizontalMargin()
+            .padding(vertical = 8.dp),
+    ) {
+        Icon(
+            painter = rememberVectorPainter(BitwardenDrawable.ic_check_mark),
+            contentDescription = null,
+            tint = BitwardenTheme.colorScheme.icon.primary,
+        )
+        Spacer(Modifier.width(12.dp))
+        Text(
+            text = text,
+            style = BitwardenTheme.typography.bodyMedium,
+            color = BitwardenTheme.colorScheme.text.primary,
+        )
+    }
+}
+
