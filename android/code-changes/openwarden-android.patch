diff --git a/app/src/main/kotlin/com/x8bit/bitwarden/data/community/CommunityFeatureAccess.kt b/app/src/main/kotlin/com/x8bit/bitwarden/data/community/CommunityFeatureAccess.kt
new file mode 100644
index 0000000000000000000000000000000000000000..373ebae8c05df3f825df9a4b2b04fa6a9a7be768
--- /dev/null
+++ b/app/src/main/kotlin/com/x8bit/bitwarden/data/community/CommunityFeatureAccess.kt
@@ -0,0 +1,35 @@
+package com.x8bit.bitwarden.data.community
+
+/**
+ * Independent feature entitlements supplied by the community fork.
+ *
+ * These flags deliberately do not alter the subscription state received from a Bitwarden server.
+ */
+object CommunityFeatureAccess {
+    /** Device-local Archive overlay; this never calls Bitwarden's archive API. */
+    const val archive: Boolean = true
+
+    /** Attachment storage and transfer are authorized by the server. */
+    const val attachments: Boolean = false
+
+    /** File Sends require server-side storage and authorization. */
+    const val fileSends: Boolean = false
+
+    /** Recipient restrictions are enforced by the server. */
+    const val sendEmailRestrictions: Boolean = false
+
+    /** Allows integrated authenticator codes. */
+    const val totp: Boolean = true
+
+    /** Indicates whether all paid capabilities are available without server authorization. */
+    const val allPaidAndroidFeatures: Boolean = false
+
+    /** OpenWarden does not advertise Bitwarden subscriptions inside the client. */
+    const val showPremiumPromotions: Boolean = false
+
+    /** Returns whether archive is available from either community or server entitlement. */
+    fun canUseArchive(isPremium: Boolean): Boolean = archive || isPremium
+
+    /** Returns whether file Sends are available from either community or server entitlement. */
+    fun canUseFileSends(isPremium: Boolean): Boolean = fileSends || isPremium
+}
