+import com.bitwarden.ui.platform.theme.BitwardenTheme
+
+/** Displays the device-local vault health report. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VaultHealthScreen(
+    onNavigateBack: () -> Unit,
+    viewModel: VaultHealthViewModel = hiltViewModel(),
+) {
+    val state by viewModel.stateFlow.collectAsStateWithLifecycle()
+    EventsEffect(viewModel = viewModel) { event ->
+        when (event) {
+            VaultHealthEvent.NavigateBack -> onNavigateBack()
+        }
+    }
+    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior(rememberTopAppBarState())
+    BitwardenScaffold(
+        topBar = {
+            BitwardenTopAppBar(
+                title = stringResource(BitwardenString.vault_health),
+                navigationIcon = rememberVectorPainter(BitwardenDrawable.ic_back),
+                navigationIconContentDescription = stringResource(BitwardenString.back),
+                onNavigationIconClick = {
+                    viewModel.trySendAction(VaultHealthAction.BackClick)
+                },
+                scrollBehavior = scrollBehavior,
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+    ) {
+        if (state.isScanning) {
+            BitwardenLoadingContent(modifier = Modifier.fillMaxSize())
+        } else {
+            VaultHealthContent(
+                state = state,
+                onScan = { viewModel.trySendAction(VaultHealthAction.ScanClick) },
+            )
+        }
+    }
+}
+
+@Composable
+private fun VaultHealthContent(
+    state: VaultHealthState,
+    onScan: () -> Unit,
+) {
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState()),
+    ) {
+        Spacer(modifier = Modifier.height(16.dp))
+        BitwardenInfoCalloutCard(
+            text = stringResource(BitwardenString.vault_health_description),
+            modifier = Modifier
+                .standardHorizontalMargin()
+                .fillMaxWidth(),
+        )
+        Spacer(modifier = Modifier.height(16.dp))
+        BitwardenFilledButton(
+            label = stringResource(BitwardenString.scan_vault),
+            onClick = onScan,
+            modifier = Modifier
+                .standardHorizontalMargin()
+                .fillMaxWidth(),
+        )
+        state.report?.let { report ->
+            Spacer(modifier = Modifier.height(24.dp))
+            Text(
+                text = stringResource(BitwardenString.vault_health_score, report.score),
+                style = BitwardenTheme.typography.titleMedium,
+                color = BitwardenTheme.colorScheme.text.primary,
+                modifier = Modifier.standardHorizontalMargin(),
+            )
+            Text(
+                text = stringResource(BitwardenString.vault_health_logins_scanned, report.total),
+                style = BitwardenTheme.typography.bodyMedium,
+                color = BitwardenTheme.colorScheme.text.secondary,
+                modifier = Modifier
+                    .standardHorizontalMargin()
+                    .padding(top = 4.dp, bottom = 12.dp),
+            )
+            HealthRow(BitwardenString.vault_health_exposed, report.exposed)
+            HealthRow(BitwardenString.vault_health_weak, report.weak)
+            HealthRow(BitwardenString.vault_health_reused, report.reused)
+            HealthRow(BitwardenString.vault_health_old, report.old)
+            HealthRow(BitwardenString.vault_health_unsecured, report.unsecured)
+            HealthRow(BitwardenString.vault_health_suspicious, report.suspicious)
+            HealthRow(BitwardenString.vault_health_duplicate, report.duplicate)
+            HealthRow(BitwardenString.vault_health_missing_two_factor, report.missingTwoFactor)
+        }
+        if (state.error) {
+            Spacer(modifier = Modifier.height(16.dp))
+            Text(
+                text = stringResource(BitwardenString.vault_health_scan_failed),
+                style = BitwardenTheme.typography.bodyMedium,
+                color = BitwardenTheme.colorScheme.status.error,
+                modifier = Modifier.standardHorizontalMargin(),
+            )
+        }
+        Spacer(modifier = Modifier.height(16.dp))
+        Spacer(modifier = Modifier.navigationBarsPadding())
+    }
+}
+
+@Composable
+private fun HealthRow(label: Int, count: Int) {
+    BitwardenTextRow(
+        text = stringResource(label),
+        onClick = {},
+        cardStyle = CardStyle.Full,
+        clickable = false,
+        modifier = Modifier
+            .standardHorizontalMargin()
+            .padding(bottom = 8.dp)
+            .fillMaxWidth(),
+    ) {
+        Text(
+            text = count.toString(),
+            style = BitwardenTheme.typography.bodyLarge,
+            color = BitwardenTheme.colorScheme.text.primary,
+        )
+    }
+}
