@@ -0,0 +1,42 @@
+import { mock } from "jest-mock-extended";
+import { firstValueFrom } from "rxjs";
+
+
+import { ApiService } from "../../abstractions/api.service";
+import { BillingAccountProfileStateService } from "../../billing/abstractions";
+import { CipherId, UserId } from "../../types/guid";
+import { CipherService } from "../abstractions/cipher.service";
+
+import { CommunityCipherArchiveService } from "./community-cipher-archive.service";
+
+describe("CommunityCipherArchiveService", () => {
+  const userId = "user-id" as UserId;
+  const cipherId = "cipher-id" as CipherId;
+  const cipherService = mock<CipherService>();
+  const service = new CommunityCipherArchiveService(
+    cipherService,
+    mock<ApiService>(),
+    mock<BillingAccountProfileStateService>(),
+  );
+
+  beforeEach(() => jest.clearAllMocks());
+
+  it("makes archive available without reporting a lapsed subscription", async () => {
+    await expect(firstValueFrom(service.userCanArchive$(userId))).resolves.toBe(true);
+    await expect(firstValueFrom(service.showSubscriptionEndedMessaging$(userId))).resolves.toBe(
+      false,
+    );
+  });
+
+  it("archives locally without calling an API", async () => {
+    await service.archiveWithServer(cipherId, userId);
+
+    expect(cipherService.updateLocalArchive).toHaveBeenCalledWith(cipherId, true, userId);
+  });
+
+  it("unarchives locally without calling an API", async () => {
+    await service.unarchiveWithServer(cipherId, userId);
+
+    expect(cipherService.updateLocalArchive).toHaveBeenCalledWith(cipherId, false, userId);
+  });
+});
diff --git a/libs/common/src/vault/services/community-cipher-archive.service.ts b/libs/common/src/vault/services/community-cipher-archive.service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ebc5943e17c3d3547ca789ace43c91204218b05f
--- /dev/null
+++ b/libs/common/src/vault/services/community-cipher-archive.service.ts
@@ -0,0 +1,49 @@
+import { Observable, of } from "rxjs";
+
+import { ApiService } from "../../abstractions/api.service";
+import { BillingAccountProfileStateService } from "../../billing/abstractions";
+import { CipherId, UserId } from "../../types/guid";
+import { CipherService } from "../abstractions/cipher.service";
+import { CipherData } from "../models/data/cipher.data";
+
+import { DefaultCipherArchiveService } from "./default-cipher-archive.service";
+
+/**
+ * Archive implementation for the community clients. Archive state is kept in
+ * the per-user local-data store and never sent to Bitwarden's archive API.
+ */
+export class CommunityCipherArchiveService extends DefaultCipherArchiveService {
+  constructor(
+    private readonly localCipherService: CipherService,
+    apiService: ApiService,
+    billingAccountProfileStateService: BillingAccountProfileStateService,
+  ) {
+    super(localCipherService, apiService, billingAccountProfileStateService);
+  }
+
+  override userCanArchive$(_userId: UserId): Observable<boolean> {
+    return of(true);
+  }
+
+  override userHasPremium$(_userId: UserId): Observable<boolean> {
+    return of(true);
+  }
+
+  override showSubscriptionEndedMessaging$(_userId: UserId): Observable<boolean> {
+    return of(false);
+  }
+
+  override async archiveWithServer(
+    ids: CipherId | CipherId[],
+    userId: UserId,
+  ): Promise<CipherData> {
+    return (await this.localCipherService.updateLocalArchive(ids, true, userId)) as CipherData;
+  }
+
+  override async unarchiveWithServer(
+    ids: CipherId | CipherId[],
+    userId: UserId,
+  ): Promise<CipherData> {
+    return (await this.localCipherService.updateLocalArchive(ids, false, userId)) as CipherData;
+  }
+}
