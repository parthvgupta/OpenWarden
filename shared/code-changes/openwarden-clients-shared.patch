+  async updateLocalArchive(
+    ids: CipherId | CipherId[],
+    archived: boolean,
+    userId: UserId,
+  ): Promise<CipherData | undefined> {
+    const cipherIds = Array.isArray(ids) ? ids : [ids];
+    const localData = { ...(await firstValueFrom(this.localData$(userId))) };
+    const archivedAt = Date.now();
+
+    for (const cipherId of cipherIds) {
+      const entry = { ...(localData[cipherId] ?? {}) };
+      if (archived) {
+        entry.communityArchivedAt = archivedAt;
+        localData[cipherId] = entry;
+      } else {
+        delete entry.communityArchivedAt;
+        if (Object.keys(entry).length === 0) {
+          delete localData[cipherId];
+        } else {
+          localData[cipherId] = entry;
+        }
+      }
+    }
+
+    const ciphers = await firstValueFrom(this.ciphers$(userId));
+    const decryptedCipherCache = await this.getDecryptedCiphers(userId);
+    for (const cipher of decryptedCipherCache) {
+      if (!cipherIds.includes(cipher.id as CipherId)) {
+        continue;
+      }
+      cipher.localData = localData[cipher.id as CipherId];
+      const serverArchivedDate = ciphers[cipher.id as CipherId]?.archivedDate;
+      cipher.archivedDate = archived
+        ? new Date(archivedAt)
+        : serverArchivedDate
+          ? new Date(serverArchivedDate)
+          : undefined;
+    }
+    await this.setDecryptedCiphers(decryptedCipherCache, userId);
+    await this.localDataState(userId).update(() => localData);
+
+    return ciphers[cipherIds[0]];
+  }
+
