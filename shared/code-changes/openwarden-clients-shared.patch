+  private computeCommunityChecks(logins: CipherView[]): {
+    old: number;
+    unsecured: number;
+    suspicious: number;
+    duplicate: number;
+    missingTwoFactor: number;
+  } {
+    const oldIds = new Set<string>();
+    const unsecuredIds = new Set<string>();
+    const suspiciousIds = new Set<string>();
+    const missingTwoFactorIds = new Set<string>();
+    const duplicateGroups = new Map<string, Set<string>>();
+    const oldPasswordCutoff = Date.now() - 180 * 24 * 60 * 60 * 1000;
+
+    for (const cipher of logins) {
+      const id = cipher.id;
+      const passwordDate = cipher.login?.passwordRevisionDate ?? cipher.revisionDate;
+      if (passwordDate != null && passwordDate.getTime() < oldPasswordCutoff) {
+        oldIds.add(id);
+      }
+
+      const uris = cipher.login?.uris ?? [];
+      if (uris.some((uri) => uri.uri?.trim().toLowerCase().startsWith("http://"))) {
+        unsecuredIds.add(id);
+      }
+      if (
+        uris.some((uri) =>
+          this.tryGetHost(uri.uri)
+            ?.split(".")
+            .some((label) => label.startsWith("xn--")),
+        )
+      ) {
+        suspiciousIds.add(id);
+      }
+
+      if (!cipher.login?.totp && !cipher.login?.hasFido2Credentials) {
+        missingTwoFactorIds.add(id);
+      }
+
+      const username = cipher.login?.username?.trim().toLowerCase() ?? "";
+      for (const uri of uris) {
+        const host = this.tryGetHost(uri.uri);
+        if (host == null) {
+          continue;
+        }
+        const key = `${host}\n${username}`;
+        const ids = duplicateGroups.get(key) ?? new Set<string>();
+        ids.add(id);
+        duplicateGroups.set(key, ids);
+      }
+    }
+
+    const duplicateIds = new Set<string>();
+    for (const ids of duplicateGroups.values()) {
+      if (ids.size > 1) {
+        ids.forEach((id) => duplicateIds.add(id));
+      }
+    }
+
+    return {
+      old: oldIds.size,
+      unsecured: unsecuredIds.size,
+      suspicious: suspiciousIds.size,
+      duplicate: duplicateIds.size,
+      missingTwoFactor: missingTwoFactorIds.size,
+    };
+  }
+
+  private tryGetHost(uri: string | null | undefined): string | null {
+    if (!uri) {
+      return null;
+    }
+    try {
+      return new URL(uri).hostname.toLowerCase() || null;
+    } catch {
+      return null;
+    }
+  }
